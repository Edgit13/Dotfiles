# Keep the tree consistent across editors. Nothing here changes behaviour.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{qml,js,json,md,yaml,yml}]
indent_size = 4

[*.{html,css}]
indent_size = 2

[Makefile]
indent_style = tab

[*.{png,jpg,jpeg,gif,mp4,webp}]
insert_final_newline = false
trim_trailing_whitespace = false
