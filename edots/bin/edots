#!/usr/bin/env bash
#
# edots — one small command for the whole rice.
#
#   edots launcher        open the launcher
#   edots settings        open the settings app
#   edots wall            open the wallpaper picker
#   edots doctor          check that everything is installed and linked
#   edots reload          restart the bar shell
#
# Every surface command auto-starts the shell if it is not running.
#
set -uo pipefail

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
REPO_DIR="$(cd -- "$(dirname -- "$SELF")/../.." && pwd)"
SHELL_QML="${EDOTS_SHELL:-$HOME/.config/quickshell/bar/shell.qml}"
QS="${EDOTS_QS:-qs}"
RELOAD_SH="$HOME/.config/quickshell/bar/reload.sh"
[ -f "$RELOAD_SH" ] || RELOAD_SH="$REPO_DIR/quickshell/bar/reload.sh"
LOCK_DIR="$HOME/.config/quickshell/bar/lockscreen"
[ -d "$LOCK_DIR" ] || LOCK_DIR="$REPO_DIR/quickshell/bar/lockscreen"
FIREFOX_HELPER="$REPO_DIR/edots/bin/link-firefox-chrome.sh"
PLUGIN_HELPER="$HOME/.config/quickshell/bar/scripts/plugins.py"
[ -f "$PLUGIN_HELPER" ] || PLUGIN_HELPER="$REPO_DIR/quickshell/bar/scripts/plugins.py"
AUDIO_HELPER="$HOME/.config/quickshell/bar/scripts/audioinfo.py"
[ -f "$AUDIO_HELPER" ] || AUDIO_HELPER="$REPO_DIR/quickshell/bar/scripts/audioinfo.py"
THEME_HELPER="$HOME/.config/mango/scripts/wallcolors.py"
[ -f "$THEME_HELPER" ] || THEME_HELPER="$REPO_DIR/mango/scripts/wallcolors.py"
SESSION_HELPER="$HOME/.config/quickshell/bar/scripts/sessionidle.py"
[ -f "$SESSION_HELPER" ] || SESSION_HELPER="$REPO_DIR/quickshell/bar/scripts/sessionidle.py"

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    C_OK=$'\033[0;32m'; C_WARN=$'\033[0;33m'; C_ERR=$'\033[0;31m'
    C_DIM=$'\033[2m'; C_BOLD=$'\033[1m'; C_OFF=$'\033[0m'
else
    C_OK=''; C_WARN=''; C_ERR=''; C_DIM=''; C_BOLD=''; C_OFF=''
fi

info() { printf '%s\n' "$*"; }
die()  { printf '%serr%s  %s\n' "$C_ERR" "$C_OFF" "$*" >&2; exit 1; }

shell_running() {
    pgrep -f 'qs .*bar/(shell|ShellNext)\.qml' >/dev/null 2>&1
}

# Never let a dead/stale instance make an `edots` command hang.
qs_ipc() {
    if command -v timeout >/dev/null 2>&1; then
        timeout 3 "$QS" -p "$SHELL_QML" ipc call "$@"
    else
        "$QS" -p "$SHELL_QML" ipc call "$@"
    fi
}

start_shell() {
    shell_running && return 0
    command -v "$QS" >/dev/null 2>&1 || die "Quickshell (qs) is not installed. See: edots doctor"
    [ -f "$SHELL_QML" ] || die "shell.qml not found: $SHELL_QML — run ./sync.sh install"

    "$QS" -d -p "$SHELL_QML" >/dev/null 2>&1 &
    for _ in $(seq 1 15); do
        shell_running && return 0
        sleep 0.2
    done
    die "the shell did not start. Run this to see why: qs -p $SHELL_QML"
}

# ipc_open <target> <function> [args...] — start the shell if needed, then retry once.
ipc_open() {
    local target="$1" fn="$2"
    shift 2

    if qs_ipc "$target" "$fn" "$@" 2>/dev/null; then
        return 0
    fi
    start_shell
    qs_ipc "$target" "$fn" "$@" \
        || die "IPC call failed: $target $fn $*"
}

# ipc_quiet <target> <function> [args...] — best effort, never starts the shell.
ipc_quiet() {
    qs_ipc "$@" >/dev/null 2>&1 || true
}

cmd_reload() {
    [ -f "$RELOAD_SH" ] || die "reload script not found: $RELOAD_SH"
    bash "$RELOAD_SH"
}

# ───────────────────────────── theme ─────────────────────────────
cmd_theme_status() {
    python3 - "$HOME/.config/quickshell/theme.json" \
              "$HOME/.config/quickshell/colors.json" \
              "$HOME/.config/mango/wallcolors-mode" <<'PY'
import json, sys
from pathlib import Path

theme_path, colors_path, mode_path = (Path(p) for p in sys.argv[1:])
try:
    theme = json.loads(theme_path.read_text(encoding="utf-8"))
except Exception:
    theme = {}
try:
    colors = json.loads(colors_path.read_text(encoding="utf-8"))
except Exception:
    colors = {}
try:
    mode = mode_path.read_text(encoding="utf-8").strip() or "unknown"
except Exception:
    mode = "unknown"

design = str(theme.get("design", "material")).capitalize()
mode_setting = str(theme.get("mode", "dark"))
dynamic = "on" if theme.get("dynamicColor", True) else "off"
accent = theme.get("accent", "#74e7c8")
print(f"Design    {design}")
print(f"Mode      {mode_setting}")
print(f"Dynamic   {dynamic}")
print(f"Accent    {accent}")
print(f"Palette   {mode}  (bg {colors.get('bg0', '—')}, fg {colors.get('fg', '—')})")
PY
}

# ───────────────────────────── doctor ─────────────────────────────
cmd_doctor() {
    local ok=0 warn=0 fail=0

    dok()   { printf '  %s✓%s %s\n' "$C_OK" "$C_OFF" "$*"; ok=$((ok + 1)); }
    dwarn() { printf '  %s!%s %s\n' "$C_WARN" "$C_OFF" "$*"; warn=$((warn + 1)); }
    dfail() { printf '  %s✗%s %s\n' "$C_ERR" "$C_OFF" "$*"; fail=$((fail + 1)); }
    dhead() { printf '\n%s%s%s\n' "$C_BOLD" "$*" "$C_OFF"; }

    local required=(qs mango mmsg matugen awww cliphist brightnessctl nmcli
                    playerctl grim tesseract python3 gcc wpctl wl-copy fc-list wlr-randr)
    local optional=(jq yay fastfetch starship blueman-applet nm-applet fd wlopm)

    dhead "Packages"
    local miss=()
    for c in "${required[@]}"; do
        command -v "$c" >/dev/null 2>&1 || miss+=("$c")
    done
    if [ "${#miss[@]}" -eq 0 ]; then
        dok "all required commands found"
    else
        dfail "missing required: ${miss[*]}"
    fi
    for c in "${optional[@]}"; do
        command -v "$c" >/dev/null 2>&1 || dwarn "optional command missing: $c"
    done
    if python3 -c 'import PIL' >/dev/null 2>&1; then
        dok "Python Pillow available (wallpaper colour index)"
    else
        dwarn "Python Pillow missing — wallpaper colour filter needs python-pillow"
    fi

    dhead "Fonts"
    local fonts=( "JetBrainsMono Nerd Font" "Material Symbols Rounded" "Google Sans Flex" )
    local font_list
    font_list="$(fc-list 2>/dev/null || true)"
    for f in "${fonts[@]}"; do
        if [[ "$font_list" == *"$f"* ]]; then
            dok "font: $f"
        else
            dwarn "font missing: $f"
        fi
    done
    if [[ "$font_list" == *"SF Pro Display"* ]]; then
        dok "font: SF Pro Display (optional)"
    else
        dwarn "font missing: SF Pro Display (optional, proprietary)"
    fi

    dhead "Config links"
    local pairs=(
        "$HOME/edots:$REPO_DIR/edots"
        "$HOME/.config/quickshell:$REPO_DIR/quickshell"
        "$HOME/.config/mango:$REPO_DIR/mango"
        "$HOME/.config/fish:$REPO_DIR/fish"
        "$HOME/.config/kitty:$REPO_DIR/kitty"
        "$HOME/.config/ghostty:$REPO_DIR/ghostty"
        "$HOME/.config/nvim:$REPO_DIR/nvim"
    )
    local pair dst src
    for pair in "${pairs[@]}"; do
        dst="${pair%%:*}"; src="${pair#*:}"
        if [ -L "$dst" ] && [ "$(readlink -f "$dst")" = "$(readlink -f "$src")" ]; then
            dok "linked: $dst"
        elif [ -e "$dst" ]; then
            dfail "not a symlink: $dst — run ./sync.sh install"
        else
            dfail "missing: $dst — run ./sync.sh install"
        fi
    done

    dhead "Session"
    if [ -n "${WAYLAND_DISPLAY:-}" ]; then
        dok "Wayland session ($WAYLAND_DISPLAY)"
    else
        dwarn "no WAYLAND_DISPLAY — are you in a Wayland session?"
    fi
    if pgrep -x mango >/dev/null 2>&1; then
        dok "MangoWM is running"
    else
        dwarn "MangoWM process not found"
    fi
    if shell_running; then
        dok "bar shell is running"
    else
        dwarn "bar shell is not running — start it with: edots reload"
    fi
    local unit
    for unit in swayidle.service; do
        if systemctl --user is-active --quiet "$unit" 2>/dev/null; then
            dok "service active: $unit"
        elif systemctl --user is-enabled --quiet "$unit" 2>/dev/null; then
            dwarn "service enabled but not running: $unit"
        else
            dwarn "service not enabled: $unit"
        fi
    done
    if command -v wlopm >/dev/null 2>&1; then
        dok "wlopm available (display-off idle timer)"
    else
        dwarn "wlopm missing — display-off idle timer disabled (sudo pacman -S wlopm)"
    fi
    if [ -f "$HOME/.config/systemd/user/edots-lockscreen.service" ]; then
        dwarn "obsolete unit present: edots-lockscreen.service — disable it with:"
        printf '      systemctl --user disable --now edots-lockscreen.service\n'
    fi

    dhead "Audio studio"
    if command -v easyeffects >/dev/null 2>&1; then
        dok "EasyEffects $(easyeffects --version 2>/dev/null | head -1 | awk '{print $2}')"
        if pgrep -x easyeffects >/dev/null 2>&1; then
            dok "DSP engine running"
        else
            dwarn "DSP engine stopped — Audio Studio starts it on demand (edots audio)"
        fi
    else
        dwarn "EasyEffects missing — EQ and mic filters unavailable (install easyeffects)"
    fi

    dhead "Colours and assets"
    local colors="$HOME/.config/quickshell/colors.json"
    if [ -f "$colors" ] && python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); assert d.get("accent")' "$colors" >/dev/null 2>&1; then
        dok "palette: $colors"
    elif [ -f "$colors" ]; then
        dwarn "palette exists but has no accent: $colors"
    else
        dwarn "no palette yet — pick a wallpaper (edots wall) or rerun install.sh"
    fi
    if [ -f "$HOME/.cache/quickshell/wallpaper-colors.json" ]; then
        dok "wallpaper colour index present"
    else
        dwarn "wallpaper colour index missing — Settings → Wallpapers → Analyze wallpapers"
    fi
    if [ -f "$REPO_DIR/quickshell/lockscreen/pam-auth.c" ]; then
        if [ -x "$REPO_DIR/quickshell/lockscreen/pam-auth" ]; then
            dok "lock screen helper compiled"
        else
            dwarn "lock screen helper not compiled — install.sh builds it (needs gcc + PAM headers)"
        fi
    fi

    dhead "Firefox"
    if command -v firefox >/dev/null 2>&1; then
        if [ -x "$FIREFOX_HELPER" ]; then
            if "$FIREFOX_HELPER" --check >/dev/null 2>&1; then
                dok "Firefox chrome linked to the Edots theme"
            else
                dwarn "Firefox chrome not linked — run: $FIREFOX_HELPER"
            fi
        else
            dwarn "Firefox helper missing: $FIREFOX_HELPER"
        fi
    else
        dwarn "Firefox not installed (optional)"
    fi

    printf '\n%sSummary:%s %s%d ok%s, %s%d warning(s)%s, %s%d error(s)%s\n' \
        "$C_BOLD" "$C_OFF" "$C_OK" "$ok" "$C_OFF" "$C_WARN" "$warn" "$C_OFF" "$C_ERR" "$fail" "$C_OFF"
    [ "$fail" -eq 0 ]
}

# ───────────────────────────── help ─────────────────────────────
usage() {
    cat <<EOF
${C_BOLD}edots${C_OFF} — control the Edots rice

${C_BOLD}Surfaces${C_OFF}
  edots launcher              launcher            (Super+Space)
  edots wall                  wallpaper picker    (Super+C)
  edots clipboard             clipboard history   (Super+V)
  edots wifi                  Wi-Fi                (Super+W)
  edots mixer                 audio mixer          (Super+X)
  edots audio                 audio studio (EQ/mic) (Super+Shift+X)
  edots display [list|keep|revert]  display centre    (Super+Shift+E)
  edots media                 media player         (Super+P)
  edots power                 power menu           (Super+O)
  edots binds                 keybind cheat-sheet  (Super+/)
  edots settings              settings app         (Super+A)
  edots dashboard             dashboard            (Super+D)
  edots tasks                 task manager         (Super+T)
  edots notifications [clear|dnd]
  edots screenshot [stop]     QuickSnip capture    (Super+U)
  edots close                 close every open surface (Super+Esc)

${C_BOLD}Per-app audio${C_OFF}
  edots app-audio             apps, volumes and saved output routes
  edots app-audio ui          open the mixer on its Apps tab
  edots app-audio sinks       list playback devices
  edots app-audio route <app> <sink>   pin an app to an output
  edots app-audio forget <app>         follow the system default again
  edots app-audio apply       move running apps to their saved outputs

${C_BOLD}Plugins${C_OFF}
  edots plugin                list installed plugins and their state
  edots plugin open <id>      open a plugin panel
  edots plugin enable <id>    enable a plugin (also: disable, toggle)
  edots plugin reload         rescan plugin folders
  edots plugin folder         open ~/.config/edots/plugins
  edots plugin path           print the user plugin folder

${C_BOLD}System${C_OFF}
  edots theme                 design, mode, accent and applied palette
  edots theme sync            repaint GTK, terminals, Firefox, rofi, KDE
  edots theme toggleDesign    Material <-> Nothing
  edots theme setMode dark    dark | light | toggleMode
  edots theme setTransition dots
  edots osd volumeUp          volumeUp|volumeDown|volumeMute|brightnessUp|brightnessDown
  edots session               idle timers, swayidle and session actions
  edots session apply         regenerate swayidle.conf from Settings
  edots session lock|suspend|logout|reboot|poweroff
  edots lock                  lock the screen              (Super+L)
  edots suspend               lock, then suspend           (Super+F3)
  edots reload                restart the bar shell        (Super+Shift+R)
  edots doctor                check packages, fonts, links, services
  edots ipc <target> <fn>     raw Quickshell IPC passthrough

  edots help | version
EOF
}

# ───────────────────────────── dispatch ─────────────────────────────
cmd="${1:-help}"
[ "$#" -gt 0 ] && shift

case "$cmd" in
    help|-h|--help)       usage ;;
    version|--version)
        if git -C "$REPO_DIR" rev-parse --git-dir >/dev/null 2>&1; then
            git -C "$REPO_DIR" describe --tags --always --dirty 2>/dev/null || echo unknown
        else
            echo unknown
        fi
        ;;

    launcher|apps)         ipc_open pill toggleLauncher ;;
    wall|wallpaper|walls)  ipc_open pill toggleWallpaper ;;
    clipboard|clip)        ipc_open pill toggleClipboard ;;
    wifi|network)          ipc_open pill toggleWifi ;;
    mixer)                 ipc_open pill toggleMixer ;;
    audio|eq|studio)       ipc_open pill toggleAudio ;;
    display|displays|monitors)
        case "${1:-}" in
            list)   python3 "$HOME/.config/quickshell/bar/scripts/displayctl.py" list ;;
            keep)   python3 "$HOME/.config/quickshell/bar/scripts/displayctl.py" keep ;;
            revert) python3 "$HOME/.config/quickshell/bar/scripts/displayctl.py" revert ;;
            *)      ipc_open pill toggleDisplay ;;
        esac
        ;;
    media|player)          ipc_open pill toggleMedia ;;
    power)                 ipc_open pill togglePower ;;
    binds|keys|shortcuts)  ipc_open pill toggleBinds ;;

    settings|config)       ipc_open settingsapp toggle ;;
    dashboard|dash)        ipc_open dashboard toggle ;;
    tasks)                 ipc_open tasks toggle ;;
    screenshot|snip|capture)
        action="${1:-toggle}"
        ipc_open screentool "$action"
        ;;
    notifications|notif)
        action="${1:-toggle}"
        ipc_open notifications "$action"
        ;;

    app-audio|perapp|per-app)
        action="${1:-status}"
        case "$action" in
            ""|list|ls|status)
                python3 "$AUDIO_HELPER" status
                ;;
            json)
                python3 "$AUDIO_HELPER" list
                ;;
            ui|open)
                ipc_open appaudio open
                ;;
            sinks)
                python3 "$AUDIO_HELPER" sinks
                ;;
            route)
                [ "$#" -ge 3 ] || die "usage: edots app-audio route <app> <sink>"
                app="$2"
                shift 2
                route_out=$(python3 "$AUDIO_HELPER" route "$app" "$*")
                if [ $? -ne 0 ]; then
                    printf '%s\n' "$route_out"
                    exit 1
                fi
                ipc_quiet appaudio refresh
                python3 "$AUDIO_HELPER" status
                ;;
            forget|auto)
                [ "$#" -ge 2 ] || die "usage: edots app-audio forget <app>"
                python3 "$AUDIO_HELPER" route "$2" auto >/dev/null || exit 1
                ipc_quiet appaudio refresh
                python3 "$AUDIO_HELPER" status
                ;;
            apply)
                python3 "$AUDIO_HELPER" apply >/dev/null || exit 1
                ipc_quiet appaudio refresh
                python3 "$AUDIO_HELPER" status
                ;;
            refresh)
                ipc_quiet appaudio refresh
                python3 "$AUDIO_HELPER" status
                ;;
            *)
                die "unknown app-audio action: $action"
                ;;
        esac
        ;;

    plugin|plugins)
        action="${1:-status}"
        case "$action" in
            ""|list|ls|status)
                python3 "$PLUGIN_HELPER" status
                ;;
            json)
                python3 "$PLUGIN_HELPER" list
                ;;
            enable|disable|toggle)
                [ "$#" -ge 2 ] || die "usage: edots plugin $action <id>"
                value="$action"
                [ "$value" = "enable" ] && value="on"
                [ "$value" = "disable" ] && value="off"
                python3 "$PLUGIN_HELPER" set "$2" "$value" >/dev/null || exit 1
                ipc_quiet plugins reload
                python3 "$PLUGIN_HELPER" status
                ;;
            open)
                [ "$#" -ge 2 ] || die "usage: edots plugin open <id>"
                ipc_open plugins open "$2"
                ;;
            reload|refresh|scan)
                ipc_open plugins reload
                python3 "$PLUGIN_HELPER" status
                ;;
            folder|dir)
                python3 "$PLUGIN_HELPER" open
                ;;
            path)
                python3 "$PLUGIN_HELPER" path
                ;;
            *)
                die "unknown plugin action: $action"
                ;;
        esac
        ;;

    theme)
        action="${1:-status}"
        case "$action" in
            status)                cmd_theme_status ;;
            sync|apply)
                command -v python3 >/dev/null 2>&1 || die "python3 is required for theme sync"
                [ -f "$THEME_HELPER" ] || die "wallcolors.py not found: $THEME_HELPER"
                python3 "$THEME_HELPER" --sync --no-shell-restart \
                    || die "theme sync failed (see ~/wallcolours.log)"
                cmd_theme_status
                ;;
            toggleDesign)          ipc_open theme toggleDesign ;;
            setMode|setTransition)
                [ "$#" -ge 2 ] || die "usage: edots theme $action <value>"
                ipc_open theme "$action" "$2"
                ;;
            *)                     die "unknown theme action: $action (try: status, sync, toggleDesign, setMode, setTransition)" ;;
        esac
        ;;
    osd)
        action="${1:-}"
        [ -n "$action" ] || die "usage: edots osd <volumeUp|volumeDown|volumeMute|brightnessUp|brightnessDown>"
        ipc_open osd "$action"
        ;;

    close)
        ipc_quiet pill close
        ipc_quiet notifications close
        ipc_quiet dashboard close
        ;;

    reload|restart)        cmd_reload ;;
    session)
        action="${1:-status}"
        [ -f "$SESSION_HELPER" ] || die "sessionidle.py not found: $SESSION_HELPER"
        case "$action" in
            status|apply|lock|suspend|logout|reboot|poweroff|pause|resume)
                exec python3 "$SESSION_HELPER" "$action" ;;
            *)  die "unknown session action: $action (try: status, apply, lock, suspend, logout, reboot, poweroff)" ;;
        esac
        ;;
    lock)
        if [ -f "$SESSION_HELPER" ]; then exec python3 "$SESSION_HELPER" lock; fi
        [ -x "$LOCK_DIR/lock.sh" ] || die "lock script not found: $LOCK_DIR/lock.sh"
        exec bash "$LOCK_DIR/lock.sh"
        ;;
    suspend|sleep)
        if [ -f "$SESSION_HELPER" ]; then exec python3 "$SESSION_HELPER" suspend; fi
        [ -x "$LOCK_DIR/suspend.sh" ] || die "suspend script not found: $LOCK_DIR/suspend.sh"
        exec bash "$LOCK_DIR/suspend.sh"
        ;;
    doctor|check)          cmd_doctor ;;
    ipc)
        [ "$#" -ge 2 ] || die "usage: edots ipc <target> <function> [args...]"
        ipc_open "$@"
        ;;
    *)
        printf 'unknown command: %s\n\n' "$cmd" >&2
        usage >&2
        exit 1
        ;;
esac
